# --- Frontend (build-time, bundled into the browser JS — visible to anyone) ---
# Used directly by src/services/geminiService.ts, imageService.ts, audioService.ts, chatService.ts
GEMINI_API_KEY=your-gemini-key-here

# --- Backend only (Vercel Serverless Functions — set these in Vercel Project Settings ---
# --- -> Environment Variables, NOT in this file, NOT prefixed with VITE_) ---
# These stay server-side and are used by api/chat.ts, api/image.ts, api/audio.ts.
# GROQ_API_KEY=your-groq-key-here
# ANTHROPIC_API_KEY=your-claude-key-here
# OPENAI_API_KEY=your-openai-key-here
